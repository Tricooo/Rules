# macOS Desktop, its helper executables, and native Claude Code installs
PROCESS-NAME,/Applications/Claude.app/
PROCESS-NAME,/Users/*/.local/share/claude/versions/*
PROCESS-NAME,Claude
PROCESS-NAME,claude

# Anthropic networks for connections to IP destinations
